<Window x:Class="SkyPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1010" Height="590" MinWidth="820" MinHeight="570"
        Topmost="{Binding Topmost}" Style="{StaticResource SkyWindow}">
  <Window.Resources>
    <!-- ATC positions grouped like the facility ladder: Center, Approach, Tower, Ground, Delivery, ATIS. -->
    <CollectionViewSource x:Key="AtcView" Source="{Binding Controllers}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <!-- A small round status light. -->
    <Style x:Key="Dot" TargetType="Ellipse">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="Fill" Value="{StaticResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ===== Top bar: connect, status, time, settings ===== -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
            Padding="12,8">
      <DockPanel>
        <Button x:Name="ConnectButton" Content="{Binding ConnectButtonText}" MinWidth="104" Click="OnConnectClick"
                ToolTip="Connect to SkyNetwork or disconnect">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
              <Style.Triggers>
                <!-- Online the main action becomes an ordinary button: nothing to do there most of the flight. -->
                <DataTrigger Binding="{Binding NetConnected}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Control}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                  <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Ellipse Margin="14,0,8,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connecting}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NetConnected}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Ok}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding NetStatus}" FontSize="14" FontWeight="SemiBold"/>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Margin="0,0,10,0" FontFamily="Consolas" FontSize="13">
            <Run Text="{Binding UtcTime, Mode=OneWay}"/><Run Text="Z" Foreground="{StaticResource Muted}"/>
          </TextBlock>
          <ToggleButton IsChecked="{Binding Topmost}" ToolTip="Keep the window on top" Margin="0,0,4,0" AutomationProperties.Name="Keep on top"
                        FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE718;" Padding="8,4">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnSettingsClick" ToolTip="Settings"
                  AutomationProperties.Name="Settings"/>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <!-- ===== Status bar: simulator, voice, traffic ===== -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
            Padding="12,4" TextElement.FontSize="12">
      <StackPanel Orientation="Horizontal">
        <Ellipse Margin="0,0,6,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SimConnected}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Ok}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding SimStatus}" ToolTip="{Binding SimError}" Foreground="{StaticResource Muted}"/>

        <Button Margin="18,0,0,0" Padding="0" MinHeight="0" Background="Transparent" BorderBrush="Transparent"
                Click="OnVoiceClick" ToolTip="{Binding VoiceTip}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Margin="0,0,6,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding VoiceConnected}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource Ok}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding VoiceFailing}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource Bad}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding VoiceText}" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Button>

        <TextBlock Margin="18,0,0,0" Foreground="{StaticResource Muted}">
          <Run Text="Traffic nearby:"/> <Run Text="{Binding TrafficCount, Mode=OneWay}" Foreground="{StaticResource Fg}"/>
        </TextBlock>
      </StackPanel>
    </Border>

    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*" MinWidth="260"/>
        <ColumnDefinition Width="286"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Left: radios, transponder, flight plan, push-to-talk ===== -->
      <DockPanel Margin="0,0,10,0">
        <Button DockPanel.Dock="Bottom" Content="{Binding PttText}" MinHeight="38" Margin="0,8,0,0" FontWeight="SemiBold"
                PreviewMouseLeftButtonDown="OnPttDown" PreviewMouseLeftButtonUp="OnPttUp" LostMouseCapture="OnPttUp"
                ToolTip="Hold to talk on the TX radio. A keyboard key or joystick button can be set in Settings">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Transmitting}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Bad}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource Bad}"/>
                  <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <StackPanel>
          <!-- COM 1 -->
          <Border Style="{StaticResource Box}" Margin="0,0,0,8">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource Toggle}" Content="RX" Width="34" Margin="0,0,4,0"
                                IsChecked="{Binding Com1Rx}" Click="OnRxTxClick" ToolTip="Listen on COM 1"/>
                  <ToggleButton Style="{StaticResource Toggle}" Content="TX" Width="34"
                                IsChecked="{Binding Com1Tx}" Click="OnRxTxClick" ToolTip="Talk and send text on COM 1"/>
                </StackPanel>
                <TextBlock Text="COM 1" Style="{StaticResource Caption}"/>
              </DockPanel>
              <TextBox x:Name="Com1Box" Style="{StaticResource Readout}" Text="{Binding Com1, Mode=OneWay}" Margin="0,4,0,0"
                       MaxLength="7" KeyDown="OnComKeyDown" Tag="1" ToolTip="Type a frequency and press Enter"/>
              <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Com1Heard}" Foreground="{StaticResource Ok}" FontSize="11.5"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Com1Station}" Foreground="{StaticResource Muted}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- COM 2 -->
          <Border Style="{StaticResource Box}" Margin="0,0,0,8">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource Toggle}" Content="RX" Width="34" Margin="0,0,4,0"
                                IsChecked="{Binding Com2Rx}" Click="OnRxTxClick" ToolTip="Listen on COM 2"/>
                  <ToggleButton Style="{StaticResource Toggle}" Content="TX" Width="34"
                                IsChecked="{Binding Com2Tx}" Click="OnRxTxClick" ToolTip="Talk and send text on COM 2"/>
                </StackPanel>
                <TextBlock Text="COM 2" Style="{StaticResource Caption}"/>
              </DockPanel>
              <TextBox x:Name="Com2Box" Style="{StaticResource Readout}" Text="{Binding Com2, Mode=OneWay}" Margin="0,4,0,0"
                       MaxLength="7" KeyDown="OnComKeyDown" Tag="2" ToolTip="Type a frequency and press Enter"/>
              <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Com2Heard}" Foreground="{StaticResource Ok}" FontSize="11.5"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Com2Station}" Foreground="{StaticResource Muted}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Transponder -->
          <Border Style="{StaticResource Box}" Margin="0,0,0,8">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource Toggle}" Width="62" Margin="0,0,4,0"
                                IsChecked="{Binding ModeC}" Content="{Binding ModeCText}" Click="OnModeCClick"
                                ToolTip="Transponder: standby or Mode C (follows the switch in the cockpit)"/>
                  <Button Content="IDENT" Width="50" MinHeight="24" Padding="0,3" FontSize="11" FontWeight="SemiBold"
                          Click="OnIdentClick" ToolTip="Squawk ident">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Identing}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
                <TextBlock Text="XPDR" Style="{StaticResource Caption}"/>
              </DockPanel>
              <TextBox x:Name="SquawkBox" Style="{StaticResource Readout}" Text="{Binding Squawk, Mode=OneWay}" Margin="0,4,0,0"
                       MaxLength="4" KeyDown="OnSquawkKeyDown" ToolTip="Type the code and press Enter"/>
            </StackPanel>
          </Border>

          <!-- Flight plan -->
          <Border Style="{StaticResource Box}">
            <StackPanel>
              <DockPanel>
                <Ellipse DockPanel.Dock="Right">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFlightPlan}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Ok}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="FLIGHT PLAN" Style="{StaticResource Caption}"/>
              </DockPanel>
              <TextBlock Text="{Binding FlightPlanRoute}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
              <TextBlock Text="{Binding FlightPlanDetails}" Foreground="{StaticResource Muted}" FontSize="11.5"
                         TextWrapping="Wrap" Margin="0,1,0,8"/>
              <UniformGrid Columns="3">
                <Button Content="SimBrief" Margin="0,0,4,0" Padding="4,3" Click="OnSimbriefClick"
                        ToolTip="Load your latest SimBrief plan and file it (SimBrief username in Settings)"/>
                <Button Content="File" Margin="2,0,2,0" Padding="4,3" Click="OnFlightPlanClick"
                        ToolTip="Open the flight plan form on the SkyNetwork website"/>
                <Button Content="Reload" Margin="4,0,0,0" Padding="4,3" Click="OnRefreshFlightPlanClick"
                        ToolTip="Load the plan filed on the website"/>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>

      <!-- ===== Centre: messages ===== -->
      <Border Grid.Column="1" Style="{StaticResource Box}" Padding="6,4,6,6">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Send" Margin="6,0,0,0" Click="OnSendClick"/>
            <Grid>
              <TextBox x:Name="Input" KeyDown="OnInputKeyDown" FontFamily="Consolas" Background="{StaticResource Bg}"/>
              <TextBlock Text="{Binding InputHint}" Foreground="{StaticResource Faint}" Margin="9,0,0,0" IsHitTestVisible="False"
                         FontSize="12" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
          <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                      Background="Transparent" BorderThickness="0" Padding="0,4,0,0">
            <TabControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                  <Ellipse Width="6" Height="6" Margin="5,0,0,0" Fill="{StaticResource Accent}"
                           Visibility="{Binding Unread, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                  <ListBox ItemsSource="{Binding Lines}" ItemContainerStyle="{StaticResource PlainItem}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="OnChatLoaded">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Foreground="{Binding Color}" Margin="2,0">
                          <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource Faint}" FontFamily="Consolas"/>
                          <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/>
                          <Run Text="{Binding Text, Mode=OneWay}"/>
                        </TextBlock>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </DockPanel>
      </Border>

      <!-- ===== Right: ATC positions ===== -->
      <Border Grid.Column="2" Style="{StaticResource Box}" Margin="10,0,0,0" Padding="4,8,4,4">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="6,0,6,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Controllers.Count}" Style="{StaticResource Caption}"/>
            <TextBlock Text="ATC" Style="{StaticResource Caption}"/>
          </DockPanel>
          <Grid>
            <TextBlock Text="No controllers online" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,24,0,0" FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasControllers}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- Double click: tune the TX radio (ATIS stations: request the ATIS). Right click: menu. -->
            <ListBox x:Name="ControllerList" ItemsSource="{Binding Source={StaticResource AtcView}}"
                     MouseDoubleClick="OnControllerDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Tune COM 1" Click="OnTuneCom1Click"/>
                  <MenuItem Header="Tune COM 2" Click="OnTuneCom2Click"/>
                  <Separator/>
                  <MenuItem Header="Request ATIS / controller info" Click="OnRequestAtisClick"/>
                  <MenuItem Header="Private message" Click="OnPrivateMessageClick"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="6,8,0,3"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- The row tooltip shows the last ATIS / controller information, once received. -->
                  <DockPanel Margin="4,3" ToolTip="{Binding AtisText}" ToolTipService.ShowDuration="60000">
                    <!-- Fixed widths keep the frequencies in one column; the letter slot is kept even when empty. -->
                    <Grid DockPanel.Dock="Right" Width="18" Margin="6,0,0,0">
                      <Border Background="{StaticResource Accent}" CornerRadius="3" VerticalAlignment="Center"
                              Visibility="{Binding HasLetter, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="{StaticResource OnAccent}"
                                   HorizontalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" Foreground="{StaticResource Muted}" FontSize="11"
                               Width="40" TextAlignment="Right"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Frequency}" FontFamily="Consolas" Margin="6,0,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                          <Setter Property="VerticalAlignment" Value="Center"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Tuned}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                              <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
