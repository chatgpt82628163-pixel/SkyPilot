<Window x:Class="SkyPilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки / Settings" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <!-- CID with registration link -->
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,3">
          <Hyperlink x:Name="RegisterLink" NavigateUri="https://sky.network.npzy2.us/register"
                     RequestNavigate="OnRegisterLinkClick">
            <TextBlock Text="Нет аккаунта? Регистрация / No account? Register"
                       Foreground="{StaticResource Accent}" FontSize="11"/>
          </Hyperlink>
        </TextBlock>
        <Label Content="CID"/>
      </DockPanel>
      <TextBox x:Name="CidBox"/>
      <Label Content="Пароль / Password"/>
      <PasswordBox x:Name="PasswordBox"/>
      <Label Content="Имя / Name"/>
      <TextBox x:Name="NameBox" ToolTip="The name controllers see / Имя, которое видят диспетчеры"/>
      <Label Content="Сервер / Server address"/>
      <TextBox x:Name="ServerBox" ToolTip="Host or host:port, e.g. sky.network.npzy2.us:6809"/>
      <Label Content="Сайт / Website"/>
      <TextBox x:Name="WebsiteBox" ToolTip="Where flight plans are filed"/>
      <Label Content="SimBrief username or Pilot ID"/>
      <TextBox x:Name="SimbriefBox" ToolTip="The SIMBRIEF button loads your latest SimBrief flight plan and files it"/>
      <Label Content="Симулятор / Simulator"/>
      <ComboBox x:Name="SimulatorBox" DisplayMemberPath="Title" SelectedValuePath="Id"
                ToolTip="Automatic finds the simulator that is running"/>
      <Label Content="Prepar3D SimConnect.dll (only if not found automatically)"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="…" Padding="10,4" Margin="6,0,0,0" Click="OnBrowseP3dClick"/>
        <TextBox x:Name="P3dDllBox"/>
      </DockPanel>
      <CheckBox x:Name="SoundBox" Content="Sound on private message / Звук при личном сообщении" Margin="0,14,0,0"/>
      <CheckBox x:Name="TopmostBox" Content="Always on top / Поверх окон" Margin="0,8,0,0"/>
      <CheckBox x:Name="UpdatesBox" Content="Check for updates at start / Проверять обновления" Margin="0,8,0,0"/>
    </StackPanel>

    <!-- Radio voice -->
    <StackPanel Grid.Column="2">
      <Label Content="Микрофон / Microphone"/>
      <ComboBox x:Name="InputBox"/>
      <Label Content="Динамики / Speakers"/>
      <ComboBox x:Name="OutputBox"/>
      <DockPanel>
        <TextBlock x:Name="MicGainText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"
                   Foreground="{StaticResource Muted}"/>
        <Label Content="Громкость микрофона / Mic gain"/>
      </DockPanel>
      <Slider x:Name="MicGainSlider" Minimum="0" Maximum="300" SmallChange="5" LargeChange="25"
              IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
      <ProgressBar x:Name="MicMeter" Height="6" Minimum="0" Maximum="1" Margin="0,4,0,0" BorderThickness="0"
                   Foreground="{StaticResource Ok}" Background="{StaticResource Panel}"
                   ToolTip="Microphone level"/>
      <DockPanel>
        <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"
                   Foreground="{StaticResource Muted}"/>
        <Label Content="Громкость приёма / RX volume"/>
      </DockPanel>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
              IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
      <CheckBox x:Name="RadioNoiseBox" Content="Шум радио / Radio noise" Margin="0,8,0,0"/>
      <Label Content="Кнопка PTT / Push-to-talk key"/>
      <DockPanel>
        <Button x:Name="PttCaptureButton" DockPanel.Dock="Right" Content="НАЗНАЧИТЬ / ASSIGN" Width="165" Margin="8,0,0,0"
                Click="OnPttCaptureClick" ToolTip="Click, then press a key or joystick button"/>
        <Button DockPanel.Dock="Right" Content="✕" Margin="8,0,0,0" Click="OnPttClearClick" ToolTip="Clear key"/>
        <TextBox x:Name="PttBox" IsReadOnly="True" Focusable="False"/>
      </DockPanel>
      <Label Content="Порт голосового сервера / Voice server port (UDP)"/>
      <TextBox x:Name="VoicePortBox" ToolTip="Default 3782"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="СОХРАНИТЬ / SAVE" IsDefault="True" Click="OnOk" Style="{StaticResource GreenButton}" Margin="0,0,8,0"/>
        <Button Content="ОТМЕНА / CANCEL" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
