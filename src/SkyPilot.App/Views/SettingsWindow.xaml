<Window x:Class="SkyPilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="700" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <Grid Margin="18,14,18,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="28"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Account" Style="{StaticResource SectionTitle}"/>
      <Label Content="CID"/>
      <TextBox x:Name="CidBox"/>
      <Label Content="Password"/>
      <PasswordBox x:Name="PasswordBox"/>
      <Label Content="Name"/>
      <TextBox x:Name="NameBox" ToolTip="The name controllers see"/>
      <Label Content="SimBrief username or Pilot ID"/>
      <TextBox x:Name="SimbriefBox" ToolTip="The SimBrief button loads your latest SimBrief flight plan and files it"/>

      <TextBlock Text="Simulator" Style="{StaticResource SectionTitle}" Margin="0,18,0,2"/>
      <Label Content="Simulator"/>
      <ComboBox x:Name="SimulatorBox" DisplayMemberPath="Title" SelectedValuePath="Id"
                ToolTip="Automatic finds the simulator that is running"/>
      <Label Content="Prepar3D SimConnect.dll (only if it is not found)"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="…" Padding="10,4" Margin="6,0,0,0" Click="OnBrowseP3dClick"/>
        <TextBox x:Name="P3dDllBox" ToolTip="Empty: SkyPilot looks in the p3d folder next to it and in the Prepar3D installation"/>
      </DockPanel>
    </StackPanel>

    <StackPanel Grid.Column="2">
      <TextBlock Text="Voice" Style="{StaticResource SectionTitle}"/>
      <Label Content="Microphone"/>
      <ComboBox x:Name="InputBox"/>
      <Label Content="Speakers / headphones"/>
      <ComboBox x:Name="OutputBox"/>
      <DockPanel>
        <TextBlock x:Name="MicGainText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                   Foreground="{StaticResource Muted}" FontSize="12"/>
        <Label Content="Microphone gain"/>
      </DockPanel>
      <Slider x:Name="MicGainSlider" Minimum="0" Maximum="300" SmallChange="5" LargeChange="25"
              IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
      <ProgressBar x:Name="MicMeter" Height="4" Minimum="0" Maximum="1" Margin="0,4,0,0"
                   ToolTip="Microphone level (shown while voice is connected)"/>
      <DockPanel>
        <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                   Foreground="{StaticResource Muted}" FontSize="12"/>
        <Label Content="Receive volume"/>
      </DockPanel>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
              IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
      <Label Content="Push-to-talk key"/>
      <DockPanel>
        <Button x:Name="PttCaptureButton" DockPanel.Dock="Right" Content="Assign" MinWidth="80" Margin="6,0,0,0"
                Click="OnPttCaptureClick" ToolTip="Click, then press a key or joystick button"/>
        <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Click="OnPttClearClick"/>
        <TextBox x:Name="PttBox" IsReadOnly="True" Focusable="False"/>
      </DockPanel>
      <CheckBox x:Name="RadioNoiseBox" Content="Radio noise (faint hiss and squelch)" Margin="0,12,0,0"/>

      <TextBlock Text="Options" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
      <CheckBox x:Name="SoundBox" Content="Sound on private message"/>
      <CheckBox x:Name="TopmostBox" Content="Keep the window on top" Margin="0,8,0,0"/>
      <CheckBox x:Name="UpdatesBox" Content="Check for updates at start" Margin="0,8,0,0"/>
    </StackPanel>

    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
        <Button Content="Save" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,0,12,0"/>
    </DockPanel>
  </Grid>
</Window>
