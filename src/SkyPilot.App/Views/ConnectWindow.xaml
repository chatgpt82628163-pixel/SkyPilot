<Window x:Class="SkyPilot.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="18,12,18,18">
    <Label Content="Callsign"/>
    <TextBox x:Name="CallsignBox" CharacterCasing="Upper" MaxLength="12" FontFamily="Consolas" FontSize="15"/>
    <Label Content="Aircraft type (ICAO)"/>
    <TextBox x:Name="TypeBox" CharacterCasing="Upper" MaxLength="4" FontFamily="Consolas" FontSize="15"
             ToolTip="For example A20N, B738, SU95"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
      <Button Content="Connect" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
    </StackPanel>
  </StackPanel>
</Window>
