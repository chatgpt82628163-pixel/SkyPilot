<Window x:Class="SkyPilot.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="20">
    <Label Content="Позывной / Callsign"/>
    <TextBox x:Name="CallsignBox" CharacterCasing="Upper" MaxLength="12"/>
    <Label Content="Тип ВС / Aircraft type"/>
    <TextBox x:Name="TypeBox" CharacterCasing="Upper" MaxLength="4" ToolTip="ICAO code, e.g. A20N or B738"/>
    <Label Content="Сервер / Server"/>
    <!-- Server is read-only: SkyNetwork is pre-selected and cannot be changed here -->
    <ComboBox x:Name="ServerBox" DisplayMemberPath="Name" IsEditable="False"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="ПОДКЛЮЧИТЬСЯ / CONNECT" IsDefault="True" Click="OnOk"
              Style="{StaticResource GreenButton}" Padding="16,8" Margin="0,0,8,0"/>
      <Button Content="ОТМЕНА / CANCEL" IsCancel="True" Padding="12,8"/>
    </StackPanel>
  </StackPanel>
</Window>
