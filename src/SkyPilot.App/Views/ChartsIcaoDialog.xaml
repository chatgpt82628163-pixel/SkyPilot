<Window x:Class="SkyPilot.App.Views.ChartsIcaoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SkyPilot.App.Resources"
        Title="Charts" Width="260" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="18,16">
    <TextBlock Text="{x:Static s:Strings.ChartsFor}" Style="{StaticResource SectionHead}" Margin="0,0,0,8"/>
    <TextBox x:Name="IcaoBox" MaxLength="4" FontFamily="Consolas" FontSize="16"
             KeyDown="OnKeyDown" ToolTip="ICAO airport code (4 letters)"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{x:Static s:Strings.CancelButton}" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="OK" Width="80" Style="{StaticResource GreenButton}" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
